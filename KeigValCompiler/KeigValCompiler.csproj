<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Finished\**" />
    <Compile Remove="Middle\**" />
    <EmbeddedResource Remove="Finished\**" />
    <EmbeddedResource Remove="Middle\**" />
    <None Remove="Finished\**" />
    <None Remove="Middle\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Executor\" />
  </ItemGroup>

  <!-- The standard library is read from beside the compiler unless "library" says otherwise. The
       directory name must match CompilerOptions.DEFAULT_LIBRARY_DIRECTORY_NAME. -->
  <ItemGroup>
    <None Include="..\library-stubs\**\*.kgvl"
          Link="library-stubs\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
