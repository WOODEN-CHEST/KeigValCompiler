namespace KGVL;

/* Thrown when a function is given null for a parameter which needs a value. As in C#, the name of the
 * parameter comes before the message in these constructors, unlike in ArgumentException's. */
public class ArgumentNullException : ArgumentException
{
    // Constants.
    private const string DefaultMessage = "Value cannot be null.";


    // Constructors.
    public ArgumentNullException() : base(DefaultMessage) { }

    public ArgumentNullException(string? paramName) : base(DefaultMessage, paramName) { }

    public ArgumentNullException(string? paramName, string? message)
        : base(message ?? DefaultMessage, paramName) { }


    // Methods.
    /* Throws an ArgumentNullException if argument is null. C# fills in the parameter's name by itself,
     * which KGVL cannot, so the overload taking it is the one to use, as in
     * ThrowIfNull(text, nameof(text)). */
    public static void ThrowIfNull(object? argument)
    {
        ThrowIfNull(argument, null);
    }

    public static void ThrowIfNull(object? argument, string? paramName)
    {
        if (argument == null)
        {
            throw new ArgumentNullException(paramName);
        }
    }
}
