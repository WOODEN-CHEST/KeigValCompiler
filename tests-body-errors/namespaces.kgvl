    public void Run()
    {
        int shared = Shared;
        Widget widget = null;
        int count = Widget.Count;
        int mixed = Mixed;
        int absent = Spaces.Absent;
        int deeper = Spaces.World.Absent;
        int found = Spaces.Level;
    }

    public static void Static()
    {
        int level = Level;
    }
}

namespace Spaces.First;

public int Shared = 1;
public int Mixed = 2;

public class Widget
{
    public static int Count;
}

namespace Spaces.Second;

public int Shared = 2;

public class Widget
{
    public static int Count;
}

public class Mixed { }

namespace Spaces.Fixed;

