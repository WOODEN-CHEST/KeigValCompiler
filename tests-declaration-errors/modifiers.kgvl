/* Declaration check test source file, for which modifiers each kind of member can have where it is
 * declared, and which cannot go together. Every error in here is deliberate. The directory parses
 * cleanly, so that resolution runs at all, and the point is that each mistake is reported once, where
 * it is, without errors which only follow from others. Run the directory with:
 *
 *     dotnet run --project KeigValCompiler -- <repository root>/tests-declaration-errors
 *
 * The whole directory gives 406 errors and 18 warnings. Expected from this
 * file, 64 errors:
 *
 *   line 82 MM error 3      virtual on a field
 *   line 83 MM error 3      static on an indexer
 *   line 84 MM error 3      const on a property
 *   line 85 MM error 3      readonly on a class's function
 *   line 86 MM error 3      required on a function
 *   line 87 MM error 3      static on an accessor
 *   line 92 MM error 3      protected in a structure
 *   line 93 MM error 3      virtual in a structure
 *   line 98 MM error 3      override in an interface
 *   line 99 MM error 3      required in an interface
 *   line 102 MM error 3     protected on a type a namespace holds
 *   line 103 MM error 3     private on a field a namespace holds
 *   line 104 MM error 3     new on a type a namespace holds
 *   line 105 MM error 3     abstract on a structure
 *   line 106 MM error 3     static on a record
 *   line 110 MM error 4     public and private together
 *   line 113 MM error 6     abstract and virtual
 *   line 114 MM error 7     override and virtual
 *   line 115 MM error 7     override and new
 *   line 116 MM error 8     sealed without override
 *   line 117 MM error 9     abstract and sealed
 *   line 118 MM error 10    static and virtual in a class
 *   line 119 MM error 11    const and static
 *   line 120 MM error 12    private and virtual
 *   line 121 MM error 13    required and static
 *   line 122 MM error 20    required on a readonly field
 *   line 123 MM error 20    required on a property without a setter
 *   line 124 MM error 15    an access modifier on a static constructor
 *   line 129 MM error 16    static and readonly on a function
 *   line 132 MM error 5     an abstract sealed class
 *   line 136 MM error 18    an abstract member of a class which is not abstract
 *   line 141 MM error 19    a virtual member of a sealed class
 *   line 151 MM error 17    public on an explicit implementation
 *   line 152 MM error 21    static on an explicit indexer, which can have no modifiers
 *   line 157 MM error 12    abstract with no access modifier, so private
 *   line 158 MM error 12    virtual with no access modifier
 *   line 159 MM error 12    override with no access modifier, in a class
 *   line 164 MM error 12    override with no access modifier, in a structure
 *   line 174 MM error 17    readonly on an explicit implementation in a class
 *   line 179 MM error 22    sealed and virtual in an interface
 *   line 180 MM error 22    private and sealed in an interface
 *   line 181 EV error 4     a virtual instance event in an interface
 *   line 182 EV error 4     a sealed instance event in an interface
 *   line 183 EV error 4     a private instance event in an interface
 *   line 191 MM error 16    a readonly accessor of a static property
 *   line 196 RTMC error 21  an operator not written public
 *   line 197 RTMC error 21  an operator not written static
 *   line 202 MM error 3     a protected operator, reported once
 *   line 212 RTMC error 28  an explicit operator implementation not written static
 *   line 217 RTMC error 29  == in an interface, neither abstract nor virtual
 *   line 218 RTMC error 29  != in an interface, likewise
 *   line 223 MM error 3     static on a record, reported once, with nothing following from it
 *   line 231 MM error 3     protected in a structure, reported once, not as private too
 *   line 236 MM error 3     a protected accessor in a structure
 *   line 242 MM error 23    a private accessor of an interface's abstract property
 *   line 247 MM error 3     an access modifier on an explicit implementation's accessor
 *   line 249 MM error 23    a private accessor of an abstract property
 *   line 254 MM error 24    a readonly property whose set has no body
 *   line 255 MM error 24    a readonly set without a body
 *   line 256 MM error 25    a readonly init
 *   line 257 MM error 26    readonly on both a property and its accessor
 *   line 258 MM error 26    readonly on both accessors
 *   line 259 MM error 26    readonly on a property's only accessor
 *   line 264 MM error 25    a readonly init on an indexer
 */

using KGVL;
namespace Test.Modifiers;

public class ModifierPlaces
{
    public virtual int VirtualField;
    public static int this[int index] { get => 0; }
    public const int ConstProperty { get; }
    public readonly void ReadonlyMethod() { }
    public required void RequiredMethod() { }
    public int Accessors { static get => 0; }
}

public struct StructPlaces
{
    protected int Hidden;
    public virtual void Virtual() { }
}

public interface IInterfacePlaces
{
    public override void Overridden();
    public required int Required { get; }
}

protected class ProtectedTopLevel { }
private int PrivateGlobal;
public new class NewTopLevel { }
public abstract struct AbstractStruct { }
public static record StaticRecord { }

public abstract class MemberConflicts
{
    public private int TwoAccess;
    protected internal int ProtectedInternalIsFine;
    private protected int PrivateProtectedIsFine;
    public abstract virtual void AbstractVirtual();
    public override virtual string ToString() => "";
    public new override int GetHashCode() => 0;
    public sealed void SealedNoOverride() { }
    public abstract sealed override bool Equals(object? obj);
    public static virtual void StaticVirtual() { }
    public static const int StaticConst = 1;
    private virtual void PrivateVirtual() { }
    public static required int StaticRequired;
    public required readonly int ReadonlyRequired;
    public required int GetOnlyRequired { get; }
    static public MemberConflicts() { }
}

public struct ReadonlyStatic
{
    public static readonly int Method() => 0;
}

public abstract sealed class AbstractSealed { }

public class AbstractInConcrete
{
    public abstract void Missing();
}

public sealed class VirtualInSealed
{
    public virtual void Pointless() { }
}

public interface IIndexed
{
    int this[int index] { get; }
}

public class ExplicitModifiers : IEquatable<int>, IIndexed
{
    public bool IEquatable<int>.Equals(int other) => true;
    static int IIndexed.this[int index] { get => 0; }
}

public abstract class ImplicitlyPrivate
{
    abstract int Area();
    virtual int Sides() => 0;
    override string ToString() => "";
}

public struct ImplicitlyPrivateStruct
{
    override string ToString() => "";
}

public interface IOther
{
    bool Check(int value);
}

public class ExplicitReadonly : IOther
{
    readonly bool IOther.Check(int value) => true;
}

public interface ISealedConflicts
{
    sealed virtual int Both() => 1;
    private sealed int Hidden() => 1;
    virtual event Handler VirtualEvent;
    sealed event Handler SealedEvent;
    private event Handler PrivateEvent;
    static virtual event Handler StaticIsFine;
}

public delegate void Handler();

public struct StaticAccessor
{
    public static int Value { readonly get => 1; set { } }
}

public class OperatorModifiers
{
    static OperatorModifiers operator +(OperatorModifiers a, OperatorModifiers b) => a;
    public OperatorModifiers operator -(OperatorModifiers a, OperatorModifiers b) => a;
}

public struct ProtectedOperator
{
    protected static ProtectedOperator operator +(ProtectedOperator a, ProtectedOperator b) => a;
}

public interface IAddable<TSelf> where TSelf : IAddable<TSelf>
{
    static abstract TSelf operator +(TSelf left, TSelf right);
}

public struct ExplicitOperator : IAddable<ExplicitOperator>
{
    ExplicitOperator IAddable<ExplicitOperator>.operator +(ExplicitOperator left, ExplicitOperator right) => left;
}

public interface IEqualityInInterface
{
    public static bool operator ==(IEqualityInInterface a, IEqualityInInterface b) => true;
    public static bool operator !=(IEqualityInInterface a, IEqualityInInterface b) => false;
    static IEqualityInInterface operator +(IEqualityInInterface a, IEqualityInInterface b) => a;
}

public record BaseRecord(int X);
public static record OneMistake(int Y) : BaseRecord
{
    protected int Tagged;
    public int Plain;
}

public struct ProtectedOverride
{
    protected override string ToString() => "";
}

public struct AccessorPlaces
{
    public int Guarded { get; protected set; }
}

public interface IProperties
{
    int Value { get; set; }
    int Hidden { get; private set; }
}

public abstract class AbstractAccessors : IProperties
{
    int IProperties.Value { get => 0; private set { } }
    int IProperties.Hidden { get => 0; set { } }
    public abstract int Secret { get; private set; }
}

public struct ReadonlyRules
{
    public readonly int StoredSet { get; set; }
    public int ReadonlyAutoSet { get; readonly set; }
    public int ReadonlyInit { get; readonly init; }
    public readonly int Twice { readonly get => 0; set { } }
    public int Both { readonly get => 0; readonly set { } }
    public int Alone { readonly get => 0; }
}

public struct ReadonlyIndexerInit
{
    public int this[int index] { get => 0; readonly init { } }
}
