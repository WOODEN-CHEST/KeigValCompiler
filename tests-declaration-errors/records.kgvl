/* Declaration check test source file, for records: the properties made from positional parameters, base
 * arguments and constructor chaining. Every error in here is deliberate. The directory parses cleanly,
 * so that resolution runs at all, and the point is that each mistake is reported once, where it is,
 * without errors which only follow from others. Run the directory with:
 *
 *     dotnet run --project KeigValCompiler -- <repository root>/tests-declaration-errors
 *
 * The whole directory gives 410 errors and 18 warnings. Expected from this
 * file, 28 errors and 1 warnings:
 *
 *   line 44 RE error 8      a declared property of another type
 *   line 49 RE error 8      a declared static property
 *   line 54 RE error 8      a declared property without get
 *   line 61 RS error 7      a declared function sharing the made property's name
 *   line 64 RS error 6      a positional parameter named like its record
 *   line 71 RE error 8      an inherited property of another type
 *   line 78 RE error 8      an inherited function
 *   line 85 RE error 8      an inherited constant
 *   line 92 RS error 27     overriding an abstract property without a setter
 *   line 99 RS error 47     overriding an abstract set with init
 *   line 103 RTMC error 43  a static class as a positional parameter's type, reported once
 *   line 112 RS error 47    a written override of set with init
 *   line 126 RE error 8     a declared override with init but no get of its own
 *   line 131 RE error 8     an inherited override with init but no get of its own
 *   line 139 RE error 9     inherited members keeping the values, hidden by the record's own, each reported
 *   line 139 RE error 9     inherited members keeping the values, hidden by the record's own, each reported
 *   line 141 RS warning 1   the record's function hiding the inherited property, also warned
 *   line 145 RE error 10    ref and out positional parameters, each reported
 *   line 145 RE error 10    ref and out positional parameters, each reported
 *   line 149 MM error 10    a static abstract property in a class, and no error for the class deriving from it
 *   line 161 RS error 47    an init overriding a set, and no error for the interface wanting set
 *   line 164 RS error 2     an inherited function, with the parameter's type named as written
 *   line 164 RE error 8     an inherited function, with the parameter's type named as written
 *   line 168 RE error 13    base arguments passed to an interface
 *   line 172 RE error 15    a positional record's constructor chaining to nothing
 *   line 173 RE error 15    a positional record's constructor chaining to base
 *   line 180 RE error 15    a constructor taking the record by "in", which is no copy constructor
 *   line 185 RE error 15    a constructor taking the record by "ref", which is no copy constructor
 *   line 190 RS error 2     a constructor's parameter of an unknown type, and no error for its missing chain
 */

namespace Test.Records;

public record WrongType(int Value)
{
    public string Value { get; init; } = "";
}

public record StaticKeeper(int Value)
{
    public static int Value { get; }
}

public record WriteOnly(int Value)
{
    public int Value { set { } }
}

public record Clashing(int Value)
{
    public void Value() { }
}

public record Named(string Named);

public record TypedBase
{
    public string Value { get; init; } = "";
}

public record FromTypedBase(int Value) : TypedBase;

public record FunctionBase
{
    public int Value() => 0;
}

public record FromFunctionBase(int Value) : FunctionBase;

public record ConstantBase
{
    public const int Value = 1;
}

public record FromConstantBase(int Value) : ConstantBase;

public abstract record ReadOnlyBase
{
    public abstract int Value { get; }
}

public record FromReadOnlyBase(int Value) : ReadOnlyBase;

public abstract record SettableBase
{
    public abstract int Value { get; set; }
}

public record FromSettableBase(int Value) : SettableBase;

public static class Tools { }

public record TakesTools(Tools Value);

public class Settable
{
    public virtual int Value { get; set; }
}

public class InitOverride : Settable
{
    public override int Value { get; init; }
}

public record Virtuals
{
    public virtual int Declared { get; init; }
    public virtual int Inherited { get; init; }
}

public record InitOnly : Virtuals
{
    public override int Inherited { init { } }
}

public record OverridesInit(int Declared) : Virtuals
{
    public override int Declared { init { } }
}

public record InheritsInit(int Inherited) : InitOnly;

public record Keeper
{
    public int First { get; init; }
    public int Second;
}

public record HidesKeeper(int First, int Second) : Keeper
{
    public void First(int value) { }
    public new class Second { }
}

public record ByReference(ref int First, out int Second, in int Third);

public abstract class StaticAbstract
{
    public static abstract int Value { get; }
}

public class FromStaticAbstract : StaticAbstract { }

public interface ISettable
{
    int Value { get; set; }
}

public class SettableAgain : Settable, ISettable
{
    public override int Value { get => 0; init { } }
}

public record UnknownFunction(Missing Value) : FunctionBase;

public interface IPositioned { }

public record PositionArguments(int X) : IPositioned(X);

public record Chained(int Value)
{
    public Chained() { }
    public Chained(bool flag) : base() { }
    public Chained(string text) : this(text.Length) { }
    public Chained(Chained original) { }
}

public record ReadCopy(int Value)
{
    public ReadCopy(in ReadCopy original) { }
}

public record RefCopy(int Value)
{
    public RefCopy(ref RefCopy original) { }
}

public record UnknownCopy(int Value)
{
    public UnknownCopy(Missing original) { }
}
