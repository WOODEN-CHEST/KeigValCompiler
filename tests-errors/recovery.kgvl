/* Error recovery test source file. Unlike tests/test.kgvl, every error in here is deliberate, and the
 * point of the file is that the compiler reports all of them in one run instead of stopping at the
 * first. Run it with:
 *
 *     dotnet run --project KeigValCompiler -- <repository root>/tests-errors
 *
 * It lives outside tests/ because the compiler reads a source directory recursively, and tests/ has
 * to keep parsing cleanly.
 *
 * Expected output, 32 errors and 2 warnings:
 *
 *   line 49 SFR warning 1   duplicate using directive
 *   line 53 MM  error 1     duplicate member modifier
 *   line 57 MM  error 2     builtin is reserved
 *   line 61 SFR error 3     stray closing bracket at the root of the file
 *   line 67 ID  error 1     invalid identifier 1Bad
 *   line 68 ID  error 1     invalid identifier 2Bad
 *   line 75 EN  error 8     no enum constant where the comma promised one
 *   line 77 EN  error 8     trailing comma after the last enum constant
 *   line 81 GE  error 4     empty generic parameter list
 *   line 87 ST  error 25    constant field without a value
 *   line 92 ST  error 25    constant local without a value
 *   line 93 ST  error 26    no declaration after const
 *   line 102 RTMC error 9   && cannot be overloaded
 *   line 103 RTMC error 9   operator true cannot be overloaded
 *   line 111 RTMC error 12  field named with an interface
 *   line 115 LI error 15    \u with too few digits in a char
 *   line 116 LI error 1     \x with too many digits in a char
 *   line 117 LI error 15    \u with too few digits in a string, whose reading carries on
 *   line 117 LI error 2     unknown escape \q later in the same string
 *   line 124 GE error 10    a second where clause for the same generic parameter
 *   line 126 RTMC error 13  a second get accessor
 *   line 127 RTMC error 13  an init accessor after a set accessor
 *   line 136 EX error 3     no type after "as"
 *   line 137 EX error 26    a throw expression where its value is needed
 *   line 138 LI error 17    a \U code point too wide for a char
 *   line 139 LI error 16    a \U code point above 10FFFF in a string
 *   line 140 EX error 1     a misplaced throw with nothing to throw, reported as that alone
 *   line 141 EX error 27    nameof of "this" alone
 *   line 142 EX error 4     nameof of a keyword after a '.'
 *   line 143 EX warning 1   a switch after an as test, which switches on the whole test
 *   line 148 RE error 11    base arguments on a record without a parameter list
 *   line 149 RE error 12    base arguments after an interface rather than first
 *   line 150 RE error 14    base arguments in an interface's base list
 *   line 157 TMC error 3    unclosed class body, found at the end of the file
 */

using KGVL;
using KGVL;

namespace Test.Recovery;

public public class DuplicateModifier { }

public class GoodAfterDuplicateModifier { }

builtin class ReservedModifier { }

public class GoodAfterReservedModifier { }

}

public class GoodAfterStrayBracket { }

public class BadMembers
{
    public class 1Bad { }
    public class 2Bad { }
    public class GoodAfterBadMembers { }
}

public enum BadEnum
{
    First,
    1,
    Second,
}

public class GoodAfterBadEnum { }

public class BadGenerics<> { }

public class GoodAfterBadGenerics { }

public class BadConstants
{
    public const int NoValue;
    public const int GoodConstant = 1;

    public void Locals()
    {
        const int alsoNoValue, goodLocal = 2;
        const 5;
        int goodAfterBadConstant = 3;
    }
}

public class GoodAfterBadConstants { }

public class BadOperators
{
    public static BadOperators operator &&(BadOperators a, BadOperators b) => a;
    public static bool operator true(BadOperators a) { return true; }
    public static BadOperators operator +(BadOperators a, BadOperators b) => a;
}

public class GoodAfterBadOperators { }

public class BadEscapesAndExplicitField : IList<int>
{
    public int IList<int>.Count;

    public void Escapes()
    {
        char tooShort = '\u12';
        char tooLong = '\x12345';
        string inText = "before \u12 and \q after";
        char fine = 'A';
    }
}

public class GoodAfterBadEscapesAndExplicitField { }

public class BadAccessorsAndClauses<T> where T : class where T : IList<T>
{
    public int Twice { get; get; }
    public int SetTwice { get; set; init; }
}

public class GoodAfterBadAccessorsAndClauses { }

public class BadValues
{
    public void Values(object x)
    {
        object noType = x as ;
        int misplacedThrow = throw new SomeException();
        char tooWide = '\U0001F600';
        string tooHigh = "\U00110000 and after";
        object nothingThrown = throw;
        string nameless = nameof(this);
        string keywordMember = nameof(x.this);
        object switched = x as string switch { _ => 1 };
        int goodAfterBadValues = 1;
    }
}

public record NoParameterList : GoodAfterBadValues(1);
public record ArgumentsNotFirst(int X) : IList<int>, GoodAfterBadValues(X);
public interface IArguments : IList<int>(1) { }

public class GoodAfterBadValues { }

public class Unclosed
{
    public class GoodInUnclosedClass { }
