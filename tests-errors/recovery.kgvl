/* Error recovery test source file. Unlike tests/test.kgvl, every error in here is deliberate, and the
 * point of the file is that the compiler reports all of them in one run instead of stopping at the
 * first. Run it with:
 *
 *     dotnet run --project KeigValCompiler -- <repository root>/tests-errors
 *
 * It lives outside tests/ because the compiler reads a source directory recursively, and tests/ has
 * to keep parsing cleanly.
 *
 * Expected output, 12 errors and 1 warning:
 *
 *   line 28 SFR warning 1   duplicate using directive
 *   line 32 MM  error 1     duplicate member modifier
 *   line 36 MM  error 2     builtin is reserved
 *   line 40 SFR error 3     stray closing bracket at the root of the file
 *   line 46 ID  error 1     invalid identifier 1Bad
 *   line 47 ID  error 1     invalid identifier 2Bad
 *   line 54 EN  error 8     no enum constant where the comma promised one
 *   line 56 EN  error 8     trailing comma after the last enum constant
 *   line 60 GE  error 4     empty generic parameter list
 *   line 66 ST  error 25    constant field without a value
 *   line 71 ST  error 25    constant local without a value
 *   line 72 ST  error 26    no declaration after const
 *   line 82 TMC error 3     unclosed class body, found at the end of the file
 */

