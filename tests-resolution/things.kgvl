/* Resolution test source file. Unlike tests/test.kgvl, which only has to parse, this has to compile
 * with zero errors: every type it names has to resolve, against the standard library, helper.kgvl, or
 * itself. declarations.kgvl, beside it, covers what the checks of declarations have to accept. Run them
 * with:
 *
 *     dotnet run --project KeigValCompiler -- <repository root>/tests-resolution
 *
 * What it covers: type keywords; library types through "using"; a generic type naming its own type
 * parameter in its base types and constraint; arrays and nullable values; a nested type, which sees
 * the type parameter of the type around it; a type found in the namespace containing this one, in
 * helper.kgvl; a generic method's own type parameter; an explicit interface implementation; an
 * indexer and an operator. */

using KGVL;
using KGVL.Collections.Generic;
namespace Game.Things;

public class Thing<T> : IEquatable<Thing<T>>, IEnumerable<T> where T : IComparable<T>
{
    public int Count;
    public string Name { get; set; }
    public T[] Values;
    public int? Maybe;
    public Inner Nested;
    public Helper Other;
    public static Thing<T> operator +(Thing<T> a, Thing<T> b) => a;
    public TOut Map<TOut>(T value, TOut fallback) => fallback;
    public bool Equals(Thing<T> other) => true;
    IEnumerator<T> IEnumerable<T>.GetEnumerator() { yield break; }
    public T this[int index] { get => Values[index]; }

    public class Inner
    {
        public T Value;
        public Thing<T> Owner;
    }
}
